# Cortex Freelancing - Direct Email Configuration
# =================================================

# 1. Recipient Email Address (Where all enquiries will be sent)
# If left blank, defaults to cortexBrand.primaryEmail ("hackathoncortex@gmail.com")
VITE_CONTACT_EMAIL=cortex@gmail.com

# 2. Optional: Web3Forms Access Key (If you prefer Web3Forms instead of FormSubmit)
# You can obtain a free access key at https://web3forms.com by entering your email.
# If left empty, the site automatically uses FormSubmit.co with zero configuration needed.
# VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key-here
